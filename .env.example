# Copy to .env for local development. Never commit real secrets.

# Signs login tokens. Use a long random value outside development.
JWT_SECRET=dev-only-change-me
# Shared by the services so only the gateway and other services can call them.
INTERNAL_KEY=dev-only-change-me-too

GATEWAY_PORT=8080
AUTH_PORT=8081
WALLET_PORT=8082
GAMES_PORT=8083

AUTH_URL=http://localhost:8081
WALLET_URL=http://localhost:8082
GAMES_URL=http://localhost:8083

# Browser origin allowed to call the gateway.
WEB_ORIGIN=http://localhost:5173

# Lets players credit themselves with play money. Development only.
DEV_FAUCET=true

DATABASE_URL=postgres://yuubet:yuubet@localhost:5432/yuubet
# Ethereum JSON-RPC endpoint for Jackpot draw entropy. Required in production;
# without it a simulated chain is used, which gives no protection.
ETH_RPC_URL=
ETH_CONFIRMATIONS=3
# A server where tests may create and drop databases. PostgreSQL tests are
# skipped when this is not set.
TEST_DATABASE_URL=postgres://yuubet:yuubet@localhost:5432/postgres
