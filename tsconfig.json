{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@yuubet/db": ["./packages/db/src/index.ts"],
      "@yuubet/db/testing": ["./packages/db/src/testing.ts"],
      "@yuubet/fair": ["./packages/fair/src/index.ts"],
      "@yuubet/games": ["./packages/games/src/index.ts"],
      "@yuubet/service-kit": ["./packages/service-kit/src/index.ts"]
    }
  },
  "include": ["packages", "services", "tests"]
}
